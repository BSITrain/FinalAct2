    <?php
    if ($_SERVER["REQUEST_METHOD"] == "POST") {

        $num1 = $_POST['num1'];
        $num2 = $_POST['num2'];
        $op = $_POST['op'];

        $result = 0;

        if ($op == "add") {
            $result = $num1 + $num2;
        } elseif ($op == "sub") {
            $result = $num1 - $num2;
        } elseif ($op == "mul") {
            $result = $num1 * $num2;
        } elseif ($op == "div") {
            if ($num2 != 0) {
                $result = $num1 / $num2;
            } else {
                $result = "Cannot divide by zero!";
            }
        }

        echo "<div class='result'>Answer: $result</div>";
    }
    ?>

